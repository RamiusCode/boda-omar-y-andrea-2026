---
// Fecha.astro
---

<section
    id="fecha-boda"
    class="relative w-full pt-2 pb-12 px-6 text-center overflow-hidden isolate"
>
    <!-- HOJA DECORATIVA FONDO -->
    <img
        src="/imagenes/textura2.webp"
        alt=""
        aria-hidden="true"
        width="480"
        height="853"
        loading="lazy"
        decoding="async"
        class="absolute bottom-4 left-0 w-52 pointer-events-none select-none opacity-[0.06]"
    />

    <!-- COPA DECORATIVA IZQUIERDA -->
    <img
        src="/imagenes/copa2.webp"
        alt=""
        aria-hidden="true"
        width="351"
        height="440"
        loading="lazy"
        decoding="async"
        class="absolute top-10 left-0 w-16 pointer-events-none select-none z-[-1]"
    />

    <!-- COPA DECORATIVA DERECHA -->
    <img
        src="/imagenes/copa2.webp"
        alt=""
        aria-hidden="true"
        width="351"
        height="440"
        loading="lazy"
        decoding="async"
        class="absolute top-10 right-0 w-16 pointer-events-none select-none scale-x-[-1] z-[-1]"
    />

    <!-- SEPARADOR -->
    <img
        src="/imagenes/separadoruva.webp"
        alt=""
        aria-hidden="true"
        width="640"
        height="171"
        loading="lazy"
        decoding="async"
        class="mx-auto mb-5 w-56 select-none pointer-events-none"
    />

    <!-- FRASE SUPERIOR (dorado) -->
    <p class="font-upcil uppercase text-[1.7rem] leading-[1.1] titulo-dorado">
        Queremos que nos<br />acompañes en nuestro día
    </p>

    <!--
        BLOQUE DE FECHA
        La columna central se dimensiona sola (auto) y las laterales se
        reparten el resto, así el número queda centrado y los textos de
        los costados nunca empujan ni cruzan los filetes verticales.
    -->
    <div class="mt-8 mx-auto max-w-[21rem] px-2">
        <!-- MES Y AÑO -->
        <p
            class="font-cormorant font-semibold uppercase tracking-[0.3em] text-xl text-[#3B0A14] mb-3"
        >
            Septiembre <span class="font-charm font-bold tracking-[0.04em]"
                >2026</span
            >
        </p>

        <!-- Filete superior -->
        <div class="h-px w-full bg-[#B08A3C]"></div>

        <!-- DÍA · NÚMERO · HORA -->
        <div class="grid grid-cols-[1fr_auto_1fr] items-center py-5">
            <div class="px-2">
                <p
                    class="font-cormorant font-semibold uppercase tracking-[0.06em] text-xl text-[#3B0A14] leading-none whitespace-nowrap"
                >
                    Sábado
                </p>
            </div>

            <div class="px-6 border-x border-[#B08A3C]/45">
                <p
                    class="font-charm font-bold text-7xl leading-none titulo-dorado"
                >
                    12
                </p>
            </div>

            <div class="px-2">
                <p
                    class="font-charm font-bold tracking-[0.04em] text-2xl text-[#3B0A14] leading-none whitespace-nowrap"
                >
                    16:00
                </p>
                <p
                    class="font-cormorant font-semibold uppercase tracking-normal text-base text-[#3B0A14]/80 mt-1.5"
                >
                    Horas
                </p>
            </div>
        </div>

        <!-- Filete inferior -->
        <div class="h-px w-full bg-[#B08A3C]"></div>
    </div>

    <!-- ICONO CALENDARIO CON CORAZÓN -->
    <div class="flex justify-center mt-6">
        <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 42 42"
            fill="none"
            class="w-10 h-10"
        >
            <rect
                x="3"
                y="8"
                width="36"
                height="30"
                rx="5"
                stroke="#B98A93"
                stroke-width="1.4"></rect>
            <line
                x1="3"
                y1="17"
                x2="39"
                y2="17"
                stroke="#B98A93"
                stroke-width="1.4"></line>
            <line
                x1="13"
                y1="3"
                x2="13"
                y2="12"
                stroke="#B98A93"
                stroke-width="1.6"
                stroke-linecap="round"></line>
            <line
                x1="29"
                y1="3"
                x2="29"
                y2="12"
                stroke="#B98A93"
                stroke-width="1.6"
                stroke-linecap="round"></line>
            <path
                d="M21 31 C21 31 14.5 26.8 14.5 23 C14.5 21.1 16 20 17.8 20 C19.2 20 20.3 20.8 21 22 C21.7 20.8 22.8 20 24.2 20 C26 20 27.5 21.1 27.5 23 C27.5 26.8 21 31 21 31Z"
                fill="#B08A3C"></path>
        </svg>
    </div>

    <!-- ESPACIO antes de Faltan -->
    <div class="mt-10"></div>

    <!-- FALTAN -->
    <p class="font-romantic text-4xl leading-none titulo-dorado">Faltan</p>

    <!-- CARD DEL CONTADOR -->
    <div class="relative mt-5 mx-2">
        <!-- LATERAL DECORATIVO IZQUIERDA -->
        <img
            src="/imagenes/lateral2.webp"
            alt=""
            aria-hidden="true"
            width="220"
            height="950"
            loading="lazy"
            decoding="async"
            class="absolute top-1/2 -left-8 w-10 pointer-events-none select-none -translate-y-1/2 z-[-1]"
        />

        <!-- LATERAL DECORATIVO DERECHA (espejo) -->
        <img
            src="/imagenes/lateral2.webp"
            alt=""
            aria-hidden="true"
            width="220"
            height="950"
            loading="lazy"
            decoding="async"
            class="absolute top-1/2 -right-8 w-10 pointer-events-none select-none scale-x-[-1] -translate-y-1/2 z-[-1]"
        />

    <div
        class="bg-white/80 rounded-2xl py-5 px-4 shadow-sm border border-[#E8D5D5]"
    >
        <div class="flex justify-around">
            <div class="flex flex-col items-center">
                <span
                    id="countdown-days"
                    class="font-charm font-bold text-4xl text-[#3B0A14] leading-none"
                    >00</span
                >
                <span class="font-cormorant text-lg text-[#3B0A14] mt-1"
                    >Días</span
                >
            </div>

            <div class="flex flex-col items-center">
                <span
                    id="countdown-hours"
                    class="font-charm font-bold text-4xl text-[#3B0A14] leading-none"
                    >00</span
                >
                <span class="font-cormorant text-base text-[#3B0A14] mt-1"
                    >Hrs.</span
                >
            </div>

            <div class="flex flex-col items-center">
                <span
                    id="countdown-minutes"
                    class="font-charm font-bold text-4xl text-[#3B0A14] leading-none"
                    >00</span
                >
                <span class="font-cormorant text-base text-[#3B0A14] mt-1"
                    >Min.</span
                >
            </div>

            <div class="flex flex-col items-center">
                <span
                    id="countdown-seconds"
                    class="font-charm font-bold text-4xl text-[#3B0A14] leading-none"
                    >00</span
                >
                <span class="font-cormorant text-base text-[#3B0A14] mt-1"
                    >S.</span
                >
            </div>
        </div>
    </div>
    </div>
</section>

<script>
    import { revelar } from "../scripts/animaciones";

    // ── FECHA DE LA BODA (ajustar aquí) ──────
    const FECHA_BODA = new Date("2026-09-12T16:00:00");
    // ──────────────────────────────────────────

    // Las referencias se buscan una sola vez, no cuatro veces por segundo.
    const casillas = {
        dias: document.getElementById("countdown-days"),
        horas: document.getElementById("countdown-hours"),
        minutos: document.getElementById("countdown-minutes"),
        segundos: document.getElementById("countdown-seconds"),
    };

    function pad(n: number): string {
        return String(n).padStart(2, "0");
    }

    // Solo se toca el DOM si el número cambió: escribir el mismo texto
    // igual obliga al navegador a recalcular esa zona.
    function escribir(el: HTMLElement | null, valor: string) {
        if (el && el.textContent !== valor) el.textContent = valor;
    }

    function actualizar() {
        const diff = FECHA_BODA.getTime() - Date.now();

        if (diff <= 0) {
            escribir(casillas.dias, "00");
            escribir(casillas.horas, "00");
            escribir(casillas.minutos, "00");
            escribir(casillas.segundos, "00");
            return;
        }

        escribir(casillas.dias, pad(Math.floor(diff / 86400000)));
        escribir(casillas.horas, pad(Math.floor((diff % 86400000) / 3600000)));
        escribir(casillas.minutos, pad(Math.floor((diff % 3600000) / 60000)));
        escribir(casillas.segundos, pad(Math.floor((diff % 60000) / 1000)));
    }

    /*
        El contador solo corre mientras la sección está en pantalla y la
        pestaña visible. Antes latía cada segundo durante todo el scroll,
        aunque la fecha estuviera a diez pantallas de distancia.
    */
    let temporizador: number | undefined;
    let visible = false;

    function arrancar() {
        if (temporizador !== undefined || !visible || document.hidden) return;
        actualizar();
        temporizador = window.setInterval(actualizar, 1000);
    }

    function detener() {
        if (temporizador === undefined) return;
        clearInterval(temporizador);
        temporizador = undefined;
    }

    const seccion = document.getElementById("fecha-boda");
    if (seccion) {
        actualizar(); // primer valor, para que nunca se vea "00"

        new IntersectionObserver(
            (entradas) => {
                visible = entradas[0].isIntersecting;
                visible ? arrancar() : detener();
            },
            { rootMargin: "200px" },
        ).observe(seccion);

        document.addEventListener("visibilitychange", () => {
            document.hidden ? detener() : arrancar();
        });
    }

    revelar(
        "#fecha-boda",
        { opacity: 0, y: 30 },
        { opacity: 1, y: 0, duration: 1.2 },
        "#fecha-boda",
        "top 85%",
    );
</script>
