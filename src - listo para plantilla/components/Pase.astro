---
// ComponentePase.astro - Pases asignados
export interface Props {
    pases?: number;
    mensaje?: string;
}

const { pases = 2, mensaje } = Astro.props;

// El mensaje se adapta a la cantidad de pases (se puede sobrescribir con la prop "mensaje")
const mensajePorDefecto =
    pases === 1
        ? "Esperamos contar con tu presencia"
        : "Esperamos contar con su presencia";

const textoMensaje = mensaje ?? mensajePorDefecto;
---

<section class="relative w-full pt-16 pb-6 px-6">

    <div class="max-w-md mx-auto">

        <!-- Contenedor principal en vino -->
        <div
            id="pase-container"
            class="relative bg-[#6E1B2B] rounded-3xl p-8 sm:p-10 text-center shadow-lg overflow-hidden"
        >

            <!-- Borde interior fino (detalle elegante) -->
            <span class="pointer-events-none absolute inset-3 sm:inset-4 border border-[#D4B473]/40 rounded-2xl"></span>

            <div class="relative z-10 flex flex-col items-center">

                <!-- Ícono de pases -->
                <div id="icono-pase" class="mb-5 text-white">
                    <svg
                        class="w-20 h-14 sm:w-24 sm:h-16"
                        viewBox="0 0 72 48"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.6"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        role="img"
                        aria-label="Pases"
                    >
                        <!-- Pase de atrás -->
                        <path d="M10 8h40a2 2 0 0 1 2 2v2.5a3.5 3.5 0 0 0 0 7V22a2 2 0 0 1-2 2H10a2 2 0 0 1-2-2v-2.5a3.5 3.5 0 0 0 0-7V10a2 2 0 0 1 2-2Z" />
                        <path d="M18 13h12M18 18h16" />
                        <path d="M43 9v14" stroke-dasharray="2 3" />

                        <!-- Pase de adelante -->
                        <path d="M22 24h40a2 2 0 0 1 2 2v2.5a3.5 3.5 0 0 0 0 7V38a2 2 0 0 1-2 2H22a2 2 0 0 1-2-2v-2.5a3.5 3.5 0 0 0 0-7V26a2 2 0 0 1 2-2Z" />
                        <path d="M30 29h12M30 34h16" />
                        <path d="M55 25v14" stroke-dasharray="2 3" />
                    </svg>
                </div>

                <!-- "PASES ASIGNADOS" -->
                <p id="texto-reservado" class="text-white text-base sm:text-lg font-cormorant font-semibold uppercase tracking-[0.3em]">
                    Pases asignados
                </p>

                <!-- Número de pases -->
                <p id="numero-pase" class="mt-3 font-charm font-bold titulo-oro-claro text-[clamp(3rem,14vw,4.5rem)] leading-none">
                    {pases}
                </p>

                <!-- "PASES" con líneas a los costados -->
                <div id="texto-pase" class="mt-3 flex items-center justify-center gap-3">
                    <span class="block w-10 sm:w-14 h-px bg-gradient-to-r from-transparent to-[#D4B473]"></span>
                    <span class="titulo-oro-claro text-base sm:text-lg font-cormorant font-semibold uppercase tracking-[0.3em]">
                        {pases === 1 ? "Pase" : "Pases"}
                    </span>
                    <span class="block w-10 sm:w-14 h-px bg-gradient-to-l from-transparent to-[#D4B473]"></span>
                </div>

                <!-- Mensaje -->
                <p id="texto-honor" class="mt-6 font-cormorant text-white text-xl leading-snug">
                    {textoMensaje}
                </p>

                <!-- Avatares -->
                <div id="avatares-pase" class="mt-6 flex items-center justify-center gap-4">
                    {
                        Array.from({ length: pases }).map(() => (
                            <div class="w-11 h-11 sm:w-12 sm:h-12 rounded-full bg-white/10 border border-[#D4B473]/60 flex items-center justify-center">
                                <svg
                                    class="w-6 h-6 text-white"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="1.6"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                >
                                    <circle cx="12" cy="8.5" r="3.5" />
                                    <path d="M5 20a7 7 0 0 1 14 0" />
                                </svg>
                            </div>
                        ))
                    }
                </div>

            </div>

        </div>

    </div>

</section>

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- 🎬 ANIMACIONES CON GSAP                                     -->
<!-- ═══════════════════════════════════════════════════════════ -->
<script>
    import { secuencia } from "../scripts/animaciones";

    /*
        Antes cada elemento creaba su propio ScrollTrigger (7 en total) y se
        encadenaban con `delay`, hasta 1,55 s. Ahora es UNA línea de tiempo con
        UN disparador: menos trabajo por cuadro y la secuencia entra en ~1,2 s.
    */
    const tl = secuencia("#pase-container", "top 85%");

    tl.fromTo(
        "#pase-container",
        { opacity: 0, y: 40 },
        { opacity: 1, y: 0, duration: 0.9 },
    )
        .fromTo(
            "#icono-pase",
            { opacity: 0, y: -16 },
            { opacity: 1, y: 0, ease: "back.out(1.6)" },
            "-=0.5",
        )
        .fromTo(
            "#texto-reservado",
            { opacity: 0 },
            { opacity: 1, duration: 0.5 },
            "-=0.35",
        )
        .fromTo(
            "#numero-pase",
            { opacity: 0, scale: 0.5 },
            { opacity: 1, scale: 1, duration: 0.7, ease: "back.out(2)" },
            "-=0.25",
        )
        .fromTo(
            "#texto-pase",
            { opacity: 0 },
            { opacity: 1, duration: 0.5 },
            "-=0.4",
        )
        .fromTo(
            "#texto-honor",
            { opacity: 0, y: 16 },
            { opacity: 1, y: 0, duration: 0.5 },
            "-=0.3",
        )
        .fromTo(
            "#avatares-pase > div",
            { opacity: 0, scale: 0.6 },
            {
                opacity: 1,
                scale: 1,
                duration: 0.5,
                ease: "back.out(1.8)",
                stagger: 0.12,
            },
            "-=0.25",
        );
</script>

<style>
    /*
        `transition: all` sobre un elemento que GSAP anima hacía que el
        navegador intentara interpolar TAMBIÉN cada transform que GSAP escribe
        en cada cuadro. Se limita a la sombra, que es lo único con hover.
    */
    #pase-container {
        transition: box-shadow 0.3s ease;
    }

    #numero-pase {
        display: inline-block;
    }
</style>
