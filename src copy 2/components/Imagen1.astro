---
// Imagen1.astro
---

<section id="imagen1" class="w-full flex justify-center overflow-hidden my-14">
    <img
        id="imagen1-img"
        src="/imagenes/imagen2.webp"
        alt="Omar y Andrea"
        width="969"
        height="1280"
        loading="lazy"
        decoding="async"
        class="block max-w-full h-auto select-none"
    />
</section>

<script>
    import { revelar } from "../scripts/animaciones";

    // Zoom suave: la foto entra ligeramente ampliada y se asienta
    // en su tamaño real mientras aparece.
    revelar(
        "#imagen1-img",
        { opacity: 0, scale: 1.08 },
        { opacity: 1, scale: 1, duration: 1.4, ease: "power3.out" },
        "#imagen1",
        "top 88%",
    );
</script>
