---
// Despedida.astro
---

<section id="despedida" class="relative w-full pt-4 pb-32 px-8 text-center overflow-hidden isolate">

    <!-- RACIMO DECORATIVO IZQUIERDA -->
    <img
        src="/imagenes/uva2.png"
        alt=""
        aria-hidden="true"
        class="absolute top-1/2 left-0 w-12 pointer-events-none select-none -translate-y-1/2 z-[-1]"
    />

    <!-- BOTELLA — ESQUINA INFERIOR IZQUIERDA -->
    <img
        src="/imagenes/vino.png"
        alt=""
        aria-hidden="true"
        class="absolute bottom-0 left-0 w-24 pointer-events-none select-none z-[-1]"
    />

    <!-- COPA — ESQUINA INFERIOR DERECHA -->
    <img
        src="/imagenes/copa2.png"
        alt=""
        aria-hidden="true"
        class="absolute bottom-0 right-0 w-24 pointer-events-none select-none scale-x-[-1] z-[-1]"
    />

    <div class="relative z-10">
    <!-- SEPARADOR IMAGEN -->
    <img
        src="/imagenes/separadoruva.png"
        alt=""
        aria-hidden="true"
        class="mx-auto mb-8 w-56 select-none pointer-events-none"
    />

    <!-- TEXTO DE DESPEDIDA -->
    <p
        class="font-cormorant text-xl text-[#5E1A26] leading-[1.85] max-w-xs mx-auto px-6"
    >
        Gracias por acompañarnos en el día más especial de nuestra historia. Su
        compañía en este día es el mayor regalo que podemos recibir. Gracias por
        sus oraciones, su cariño y por ser parte de nuestro camino. Estamos
        agradecidos con Dios por permitirnos celebrar este momento con ustedes,
        nuestra familia y amigos más queridos.
    </p>

    <!-- CON TODO NUESTRO AMOR -->
    <p class="font-upcil uppercase text-2xl text-[#6E1B2B] mt-8">
        Con todo nuestro amor
    </p>

    <!-- NOMBRES -->
    <!-- NOMBRES (mismo estilo que NombresFlores.astro) -->
    <h2
        class="font-romantic mt-3 leading-[1.45] dorado-solido"
        style="font-size: clamp(2.1rem, 9.5vw, 3.1rem);"
    >
        Omar Alexander
        <span class="block font-romantic my-2" style="font-size: 0.62em;">y</span>
        Andrea Eugenia
    </h2>
    </div>
</section>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", () => {
        gsap.fromTo(
            "#despedida",
            { opacity: 0, y: 28 },
            {
                opacity: 1,
                y: 0,
                duration: 1.4,
                ease: "power2.out",
                scrollTrigger: {
                    trigger: "#despedida",
                    start: "top 82%",
                    toggleActions: "play none none reset",
                },
            },
        );
    });
</script>
