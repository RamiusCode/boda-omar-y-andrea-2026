---
// Dedicatoria.astro
---

<section
    id="dedicatoria"
    class="relative w-full pt-2 pb-10 px-8 flex justify-center isolate"
>
    <!-- DECORACIÓN VINO (izquierda) -->
    <img
        src="/imagenes/vino.png"
        alt=""
        aria-hidden="true"
        class="absolute -bottom-4 left-0 w-32 pointer-events-none select-none z-[-1]"
    />

    <p
        id="texto-dedicatoria"
        class="font-cormorant italic text-center text-xl leading-[1.9] max-w-xs relative z-10"
        style="color: #5E1A26;"
    >
        «Más valen dos que uno, porque obtienen más fruto de su esfuerzo. Si
        caen, el uno levanta al otro.»
        <span
            class="block not-italic font-upcil text-3xl tracking-normal mt-5 texto-oro"
        >
            Eclesiastés 4:9-10
        </span>
    </p>
</section>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", () => {
        gsap.fromTo(
            "#texto-dedicatoria",
            { opacity: 0, y: 32 },
            {
                opacity: 1,
                y: 0,
                duration: 1.4,
                ease: "power2.out",
                scrollTrigger: {
                    trigger: "#dedicatoria",
                    start: "top 82%",
                    toggleActions: "play none none reset",
                },
            },
        );
    });
</script>
