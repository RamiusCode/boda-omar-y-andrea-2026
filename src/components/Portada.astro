---
// Portada.astro
---

<section
    id="portada-sobre"
    class="fixed inset-0 w-full h-screen z-50 overflow-hidden"
    style="background-color: #5E1524;"
>
    <!-- SOBRE - fondo que ocupa todo el ancho de la pantalla -->
    <img
        id="sobre-img"
        src="/imagenes/sobre.webp"
        alt="Sobre de invitación"
        class="absolute top-0 left-0 w-full h-full object-cover object-top"
    />

    <!-- TEXTO SUPERIOR - ¡NOS CASAMOS! en dorado sobre el sobre vino -->
    <div
        id="texto-superior"
        class="absolute top-[8%] left-0 right-0 text-center z-20 px-6"
    >
        <p
            class="font-cormorant uppercase tracking-[0.3em] text-2xl md:text-3xl font-semibold texto-dorado"
        >
            ¡Nos Casamos!
        </p>
    </div>

    <!-- SELLO / BOTÓN - centrado sobre la imagen -->
    <div class="absolute inset-0 flex items-center justify-center z-20">
        <button
            id="btn-sello"
            class="cursor-pointer transition-all duration-300 hover:scale-110 active:scale-95 focus:outline-none"
        >
            <img
                src="/imagenes/boton.png"
                alt="Sello W y Y"
                class="w-28 h-28 md:w-32 md:h-32"
                style="filter: drop-shadow(0 4px 10px rgba(30, 5, 12, 0.4));"
            />
        </button>
    </div>

    <!-- TEXTO - posicionado sobre la portada -->
    <div
        id="texto-portada"
        class="absolute bottom-[18%] left-0 right-0 text-center z-20 px-6 flex flex-col items-center"
    >
        <p
            class="font-cormorant uppercase tracking-[0.32em] text-sm md:text-base font-semibold texto-blanco"
        >
            DALE CLIC AL SELLO
        </p>
        <p
            class="font-cormorant uppercase tracking-normal text-sm md:text-base font-medium mt-0.5 texto-blanco"
        >
            PARA INGRESAR A LA INVITACIÓN
        </p>

        <!-- Filete dorado decorativo -->
        <span class="filete-dorado mt-4"></span>

        <p class="font-crimson italic text-xl md:text-2xl mt-3 texto-crema">
            Atentamente:
        </p>
        <h2
            class="font-romantic text-3xl md:text-4xl mt-3 leading-tight whitespace-nowrap texto-dorado"
        >
            Omar
            <span
                class="font-romantic texto-blanco"
                style="font-size: 0.82em;"
            >y</span>
            Andrea
        </h2>
    </div>
</section>

<script>
    import { gsap } from "gsap";

    document.addEventListener("DOMContentLoaded", () => {
        const btnSello = document.getElementById("btn-sello");
        const portada = document.getElementById("portada-sobre");

        // Entrada del sello con efecto elástico
        gsap.from("#btn-sello", {
            scale: 0.8,
            duration: 1.5,
            ease: "elastic.out(1, 0.5)",
            delay: 0.5,
        });

        // Respiración continua del sello
        gsap.to("#btn-sello", {
            scale: 1.05,
            duration: 2.5,
            ease: "sine.inOut",
            yoyo: true,
            repeat: -1,
        });

        // Entrada suave del texto inferior
        gsap.from("#texto-portada", {
            opacity: 0,
            y: 18,
            duration: 1.2,
            ease: "power2.out",
            delay: 0.4,
        });

        // Entrada del texto superior ¡Nos Casamos!
        gsap.from("#texto-superior", {
            opacity: 0,
            y: -16,
            duration: 1.2,
            ease: "power2.out",
            delay: 0.3,
        });

        btnSello?.addEventListener("click", () => {
            const audio = new Audio("/musica/melodia.mp3");
            audio.loop = true;
            audio.volume = 0.5;
            audio.play().catch((error: any) => {
                console.log("Error al reproducir audio:", error);
            });

            (window as any).audioGlobal = audio;
            (window as any).estaReproduciendoGlobal = true;

            setTimeout(() => {
                const iconoPlay = document.getElementById("icono-play");
                const iconoPause = document.getElementById("icono-pause");

                if (iconoPlay && iconoPause) {
                    iconoPlay.classList.add("hidden");
                    iconoPause.classList.remove("hidden");
                }
            }, 100);

            gsap.to(portada, {
                opacity: 0,
                duration: 0.8,
                ease: "power2.out",
                onStart: () => {
                    document.body.style.overflow = "auto";
                },
                onComplete: () => {
                    portada?.remove();
                },
            });
        });
    });
</script>

<style>
    body {
        overflow: hidden;
    }

    /* Dorado plano — sobre el sobre vino va un tono más claro */
    .texto-dorado {
        color: #d4b473;
    }

    .texto-blanco {
        color: #ffffff;
    }

    .texto-crema {
        color: #f6e6d6;
    }

    /* Filete dorado decorativo */
    .filete-dorado {
        display: block;
        width: 120px;
        height: 1px;
        background-color: #d4b473;
    }
</style>
