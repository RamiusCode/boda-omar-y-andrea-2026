---
// DireccionCeremonia.astro
---

<section
    id="direccion-ceremonia"
    class="relative w-full py-6 px-6 overflow-hidden isolate"
>
    <!-- FLOR DECORATIVA IZQUIERDA -->
    <img
        src="/imagenes/florcostado.png"
        alt=""
        aria-hidden="true"
        class="absolute top-1/2 right-0 w-24 pointer-events-none select-none scale-x-[-1] -translate-y-1/2 z-[-1]"
    />

    <div class="relative z-10 max-w-md mx-auto">
        <!-- TARJETA CON BORDE REDONDEADO -->
        <div
            id="iglesia-card"
            class="relative border border-[#6E1B2B]/60 rounded-3xl p-8 sm:p-10 bg-white shadow-lg text-center overflow-hidden"
        >
            <!-- Borde interior fino (detalle elegante) -->
            <span
                class="pointer-events-none absolute inset-3 sm:inset-4 border border-[#6E1B2B]/25 rounded-2xl"
            ></span>

            <div class="relative">
                <!-- TÍTULO -->
                <div id="iglesia-titulo" class="mb-2">
                    <h3
                        class="font-romantic text-[clamp(1.75rem,7vw,2.9rem)] leading-tight tracking-wide whitespace-nowrap titulo-dorado"
                    >
                        Ceremonia Religiosa
                    </h3>
                </div>

                <!-- DIVISOR ORNAMENTAL -->
                <div class="flex items-center justify-center gap-3 mb-5">
                    <span
                        class="block w-10 sm:w-14 h-px bg-gradient-to-r from-transparent to-[#6E1B2B]/70"
                    ></span>
                    <span class="w-1.5 h-1.5 rotate-45 rombo-oro"></span>
                    <span
                        class="block w-10 sm:w-14 h-px bg-gradient-to-l from-transparent to-[#6E1B2B]/70"
                    ></span>
                </div>

                <!-- ICONO DE IGLESIA -->
                <div id="iglesia-icono" class="mb-5 flex justify-center">
                    <div
                        class="w-16 h-16 sm:w-20 sm:h-20 flex items-center justify-center"
                    >
                        <div
                            role="img"
                            aria-label="Iglesia"
                            class="w-full h-full"
                            style="background-color: #6E1B2B; -webkit-mask: url('/imagenes/iglesia.png') center / contain no-repeat; mask: url('/imagenes/iglesia.png') center / contain no-repeat;"
                        >
                        </div>
                    </div>
                </div>

                <!-- NOMBRE DE LA IGLESIA -->
                <div id="iglesia-nombre" class="mb-5">
                    <p
                        class="font-cormorant font-bold text-[#6E1B2B] text-xl tracking-normal leading-snug uppercase"
                    >
                        Iglesia El Hospicio
                    </p>
                    <p
                        class="font-cormorant text-[#5E1A26] text-lg leading-snug mt-2 px-2"
                    >
                        Calle Mayor Rocha, frente a la Plazuela Colón<br />
                        <span class="italic">(sobre la calle 25 de Mayo)</span>
                    </p>
                </div>

                <!-- HORA -->
                <div id="iglesia-hora" class="mb-6">
                    <p
                        class="font-cormorant text-sm sm:text-base md:text-lg text-[#8E2334] uppercase tracking-[0.25em] mb-2"
                    >
                        Hora
                    </p>
                    <p
                        class="font-charm font-bold text-[#6E1B2B] text-[clamp(1.35rem,5.5vw,1.8rem)] tracking-wide leading-none"
                    >
                        16:00
                    </p>
                </div>

                <!-- BOTÓN "VER UBICACIÓN" -->
                <div id="iglesia-boton">
                    <a
                        href="https://maps.app.goo.gl/nzsPNB3DD3cFUeMe6"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="group relative inline-block bg-[#6E1B2B] text-white px-9 py-3 rounded-full text-sm font-cormorant uppercase tracking-widest hover:bg-[#4E1220] transition-all duration-300 shadow-md hover:shadow-lg hover:-translate-y-0.5"
                    >
                        <span
                            class="pointer-events-none absolute inset-1.5 rounded-full border border-[#D4B473]/60 transition-all duration-300 group-hover:inset-[7px]"
                        ></span>
                        <span
                            class="relative inline-flex items-center gap-2 justify-center"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="w-3.5 h-3.5"
                                viewBox="0 0 24 24"
                                fill="currentColor"
                            >
                                <path
                                    d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z"
                                ></path>
                            </svg>
                            Ver ubicación
                        </span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- 🎬 ANIMACIONES CON GSAP                                     -->
<!-- ═══════════════════════════════════════════════════════════ -->
<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", () => {
        const st = {
            trigger: "#iglesia-card",
            start: "top 80%",
            toggleActions: "play none none reverse",
        };

        // ═══ TARJETA PRINCIPAL ═══
        gsap.fromTo(
            "#iglesia-card",
            { opacity: 0, scale: 0.8, y: 50 },
            {
                opacity: 1,
                scale: 1,
                y: 0,
                duration: 1,
                ease: "back.out(1.4)",
                scrollTrigger: st,
            },
        );

        // ═══ TÍTULO ═══
        gsap.fromTo(
            "#iglesia-titulo",
            { opacity: 0, y: -20 },
            {
                opacity: 1,
                y: 0,
                duration: 0.8,
                ease: "power2.out",
                scrollTrigger: st,
                delay: 0.3,
            },
        );

        // ═══ ICONO DE IGLESIA ═══
        gsap.fromTo(
            "#iglesia-icono",
            { opacity: 0, scale: 0.5, rotation: -10 },
            {
                opacity: 1,
                scale: 1,
                rotation: 0,
                duration: 0.8,
                ease: "back.out(1.7)",
                scrollTrigger: st,
                delay: 0.6,
            },
        );

        // ═══ NOMBRE DE LA IGLESIA ═══
        gsap.fromTo(
            "#iglesia-nombre",
            { opacity: 0, y: 20 },
            {
                opacity: 1,
                y: 0,
                duration: 0.6,
                ease: "power2.out",
                scrollTrigger: st,
                delay: 0.9,
            },
        );

        // ═══ HORA ═══
        gsap.fromTo(
            "#iglesia-hora",
            { opacity: 0, scale: 0.7 },
            {
                opacity: 1,
                scale: 1,
                duration: 0.8,
                ease: "back.out(1.5)",
                scrollTrigger: st,
                delay: 1.2,
            },
        );

        // ═══ BOTÓN "VER UBICACIÓN" ═══
        gsap.fromTo(
            "#iglesia-boton",
            { opacity: 0, y: 20 },
            {
                opacity: 1,
                y: 0,
                duration: 0.6,
                ease: "power2.out",
                scrollTrigger: st,
                delay: 1.5,
            },
        );
    });
</script>

<style>
    /* Transiciones suaves en la tarjeta */
    #iglesia-card {
        transition: all 0.3s ease;
    }

    #iglesia-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 20px 40px rgba(94, 21, 36, 0.18);
    }

    /* Efecto hover en el título */
    #iglesia-titulo:hover {
        transform: scale(1.05);
        transition: transform 0.3s ease;
    }

    /* Animación del botón */
    #iglesia-boton a:active {
        transform: scale(0.95);
    }
</style>
