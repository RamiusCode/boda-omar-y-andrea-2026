---
// Itinerario.astro
---

<section
    id="itinerario"
    class="relative w-full py-10 px-6 overflow-hidden isolate"
>
    <!-- FLOR DECORATIVA IZQUIERDA -->
    <img
        src="/imagenes/florcostado.png"
        alt=""
        aria-hidden="true"
        class="absolute top-1/2 left-0 w-24 pointer-events-none select-none -translate-y-1/2 z-[-1]"
    />

    <!-- TÍTULO -->
    <p
        class="font-romantic text-4xl text-center mb-10 leading-none titulo-dorado"
    >
        Itinerario
    </p>

    <!-- TIMELINE GRID -->
    <div class="relative max-w-sm mx-auto">
        <!-- Línea vertical central -->
        <div
            class="absolute left-1/2 top-0 bottom-0 -translate-x-1/2"
            style="border-left: 1.5px dashed rgba(185,138,147,0.5);"
        >
        </div>

        <div class="grid grid-cols-2">
            <!-- ── FILA 1 ── -->
            <div class="flex flex-col items-center text-center pr-3 pb-2">
                <img
                    src="/imagenes/iglesia.png"
                    class="w-12 h-12 icono-vino"
                />
                <p
                    class="font-cormorant uppercase text-base text-[#3B0A14] mt-2 leading-tight"
                >
                    Ceremonia<br />Religiosa
                </p>
                <p
                    class="font-charm font-bold text-xl text-[#3B0A14] mt-1 leading-none"
                >
                    16:00 Hrs.
                </p>
                <div
                    class="w-full border-t border-dashed border-[#B98A93] opacity-50 mt-2"
                >
                </div>
            </div>
            <div class="flex flex-col items-center text-center pl-3 pb-2 pt-8">
                <img
                    src="/imagenes/recepcion.png"
                    class="w-12 h-12 icono-vino"
                />
                <p
                    class="font-cormorant uppercase text-base text-[#3B0A14] mt-2 leading-tight"
                >
                    Recepción<br />Social
                </p>
                <p
                    class="font-charm font-bold text-xl text-[#3B0A14] mt-1 leading-none"
                >
                    17:30 Hrs.
                </p>
                <div
                    class="w-full border-t border-dashed border-[#B98A93] opacity-50 mt-auto"
                >
                </div>
            </div>

            <!-- ── FILA 2 ── -->
            <div class="flex flex-col items-center text-center pr-3 pb-2 pt-3">
                <img
                    src="/imagenes/brindis.png"
                    class="w-12 h-12 icono-vino"
                />
                <p
                    class="font-cormorant uppercase text-base text-[#3B0A14] mt-2 leading-tight"
                >
                    Brindis<br />y Vals
                </p>
                <p
                    class="font-charm font-bold text-xl text-[#3B0A14] mt-1 leading-none"
                >
                    18:00 Hrs.
                </p>
                <div
                    class="w-full border-t border-dashed border-[#B98A93] opacity-50 mt-2"
                >
                </div>
            </div>
            <div class="flex flex-col items-center text-center pl-3 pb-2 pt-8">
                <img src="/imagenes/cena.png" class="w-12 h-12 icono-vino" />
                <p
                    class="font-cormorant uppercase text-base text-[#3B0A14] mt-2 leading-tight"
                >
                    Cena
                </p>
                <p
                    class="font-charm font-bold text-xl text-[#3B0A14] mt-1 leading-none"
                >
                    19:00 Hrs.
                </p>
                <div
                    class="w-full border-t border-dashed border-[#B98A93] opacity-50 mt-auto"
                >
                </div>
            </div>

            <!-- ── FILA 3 ── -->
            <div class="flex flex-col items-center text-center pr-3 pb-2 pt-3">
                <img src="/imagenes/ramo.png" class="w-12 h-12 icono-vino" />
                <p
                    class="font-cormorant uppercase text-base text-[#3B0A14] mt-2 leading-tight"
                >
                    Bouquet
                </p>
                <p
                    class="font-charm font-bold text-xl text-[#3B0A14] mt-1 leading-none"
                >
                    20:00 Hrs.
                </p>
                <div
                    class="w-full border-t border-dashed border-[#B98A93] opacity-50 mt-2"
                >
                </div>
            </div>
            <div class="flex flex-col items-center text-center pl-3 pb-2 pt-8">
                <img src="/imagenes/torta.png" class="w-12 h-12 icono-vino" />
                <p
                    class="font-cormorant uppercase text-base text-[#3B0A14] mt-2 leading-tight"
                >
                    Partimos<br />la Torta
                </p>
                <p
                    class="font-charm font-bold text-xl text-[#3B0A14] mt-1 leading-none"
                >
                    21:00 Hrs.
                </p>
                <div
                    class="w-full border-t border-dashed border-[#B98A93] opacity-50 mt-auto"
                >
                </div>
            </div>

            <!-- ── FILA 4 ── -->
            <div class="flex flex-col items-center text-center pr-3 pt-3">
                <img
                    src="/imagenes/bailando.png"
                    class="w-12 h-12 icono-vino"
                />
                <p
                    class="font-cormorant uppercase text-base text-[#3B0A14] mt-2 leading-tight"
                >
                    El comienzo<br />de todo
                </p>
                <p
                    class="font-charm font-bold text-xl text-[#3B0A14] mt-1 leading-none"
                >
                    22:00 Hrs.
                </p>
            </div>
            <div></div>
        </div>
    </div>
</section>

<script>
    import { revelar } from "../scripts/animaciones";

    revelar(
        "#itinerario",
        { opacity: 0, y: 30 },
        { opacity: 1, y: 0, duration: 1.2 },
        "#itinerario",
        "top 85%",
    );
</script>

<style>
    .icono-vino {
        filter: brightness(0) saturate(100%) invert(13%) sepia(94%)
            saturate(1565%) hue-rotate(324deg) brightness(92%) contrast(95%);
    }
</style>
