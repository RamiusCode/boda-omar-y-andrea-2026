---
// DireccionRecepcion.astro
---

<section
    id="direccion-recepcion"
    class="relative w-full py-6 px-6 overflow-hidden isolate"
>
    <div class="relative z-10 max-w-md mx-auto">
        <!-- RAMO SOBRE LA ESQUINA SUPERIOR IZQUIERDA -->
        <img
            src="/imagenes/flrocard.webp"
            alt=""
            aria-hidden="true"
            width="165"
            height="328"
            loading="lazy"
            decoding="async"
            class="absolute -top-6 -left-12 w-20 sm:w-24 pointer-events-none select-none z-20"
        />

        <!-- RAMO SOBRE LA ESQUINA INFERIOR DERECHA (girado 180°) -->
        <img
            src="/imagenes/flrocard.webp"
            alt=""
            aria-hidden="true"
            width="165"
            height="328"
            loading="lazy"
            decoding="async"
            class="absolute -bottom-6 -right-12 w-20 sm:w-24 pointer-events-none select-none rotate-180 z-20"
        />

        <!-- TARJETA CON BORDE REDONDEADO -->
        <div
            id="recepcion-card"
            class="relative border border-[#6E1B2B]/60 rounded-3xl p-8 sm:p-10 bg-white shadow-lg text-center overflow-hidden"
        >
            <!-- Borde interior fino (detalle elegante) -->
            <span
                class="pointer-events-none absolute inset-3 sm:inset-4 border border-[#6E1B2B]/25 rounded-2xl"
            ></span>

            <div class="relative">
                <!-- TÍTULO -->
                <div id="recepcion-titulo" class="mb-2">
                    <h3
                        class="font-romantic text-[clamp(1.75rem,7vw,2.9rem)] leading-tight tracking-wide whitespace-nowrap titulo-dorado"
                    >
                        Recepción Social
                    </h3>
                </div>

                <!-- DIVISOR ORNAMENTAL -->
                <div class="flex items-center justify-center gap-3 mb-5">
                    <span
                        class="block w-10 sm:w-14 h-px bg-gradient-to-r from-transparent to-[#6E1B2B]/70"
                    ></span>
                    <span class="w-1.5 h-1.5 rotate-45 rombo-oro"></span>
                    <span
                        class="block w-10 sm:w-14 h-px bg-gradient-to-l from-transparent to-[#6E1B2B]/70"
                    ></span>
                </div>

                <!-- ICONO DE RECEPCIÓN -->
                <div id="recepcion-icono" class="mb-5 flex justify-center">
                    <div
                        class="w-16 h-16 sm:w-20 sm:h-20 flex items-center justify-center"
                    >
                        <div
                            role="img"
                            aria-label="Recepción"
                            class="w-full h-full"
                            style="background-color: #6E1B2B; -webkit-mask: url('/imagenes/recepcion.png') center / contain no-repeat; mask: url('/imagenes/recepcion.png') center / contain no-repeat;"
                        >
                        </div>
                    </div>
                </div>

                <!-- NOMBRE DEL SALÓN -->
                <div id="recepcion-nombre" class="mb-5">
                    <p
                        class="font-cormorant font-bold text-[#3B0A14] text-2xl tracking-normal leading-snug uppercase"
                    >
                        Casa Campestre de la SIB
                       
                    </p>
                    <p
                        class="font-cormorant text-[#3B0A14] text-xl leading-snug mt-2 px-2"
                    >
                        Av. La Floresta, 3 cuadras al Oeste de la<br />Av.
                        Reducto, Tiquipaya, Cochabamba
                    </p>
                </div>

                <!-- HORA -->
                <div id="recepcion-hora" class="mb-6">
                    <p
                        class="font-cormorant text-base sm:text-lg md:text-xl text-[#3B0A14] uppercase tracking-[0.25em] mb-2"
                    >
                        Hora
                    </p>
                    <p
                        class="font-charm font-bold text-[#3B0A14] text-[clamp(1.35rem,5.5vw,1.8rem)] tracking-wide leading-none"
                    >
                        17:30
                    </p>
                </div>

                <!-- BOTÓN "VER UBICACIÓN" -->
                <div id="recepcion-boton">
                    <a
                        href="https://maps.app.goo.gl/SXWHrBW8bGYdDJ9U6"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="group relative inline-block bg-[#6E1B2B] text-white px-9 py-3 rounded-full text-base font-cormorant uppercase tracking-widest hover:bg-[#4E1220] transition-all duration-300 shadow-md hover:shadow-lg hover:-translate-y-0.5"
                    >
                        <span
                            class="pointer-events-none absolute inset-1.5 rounded-full border border-[#D4B473]/60 transition-all duration-300 group-hover:inset-[7px]"
                        ></span>
                        <span
                            class="relative inline-flex items-center gap-2 justify-center"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="w-3.5 h-3.5"
                                viewBox="0 0 24 24"
                                fill="currentColor"
                            >
                                <path
                                    d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z"
                                ></path>
                            </svg>
                            Ver ubicación
                        </span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- 🎬 ANIMACIONES CON GSAP                                     -->
<!-- ═══════════════════════════════════════════════════════════ -->
<script>
    import { secuencia } from "../scripts/animaciones";

    /*
        Misma estructura que la ceremonia: una línea de tiempo con un solo
        disparador, sin escalar la tarjeta (evita redibujar sombra y bordes
        redondeados en cada cuadro).
    */
    const tl = secuencia("#recepcion-card", "top 85%");

    tl.fromTo(
        "#recepcion-card",
        { opacity: 0, y: 40 },
        { opacity: 1, y: 0, duration: 0.9 },
    )
        .fromTo(
            "#recepcion-titulo",
            { opacity: 0, y: -16 },
            { opacity: 1, y: 0 },
            "-=0.55",
        )
        .fromTo(
            "#recepcion-icono",
            { opacity: 0, y: 12 },
            { opacity: 1, y: 0, duration: 0.5 },
            "-=0.4",
        )
        .fromTo(
            "#recepcion-nombre",
            { opacity: 0, y: 16 },
            { opacity: 1, y: 0, duration: 0.5 },
            "-=0.3",
        )
        .fromTo(
            "#recepcion-hora",
            { opacity: 0, y: 12 },
            { opacity: 1, y: 0, duration: 0.5 },
            "-=0.3",
        )
        .fromTo(
            "#recepcion-boton",
            { opacity: 0, y: 16 },
            { opacity: 1, y: 0, duration: 0.5 },
            "-=0.3",
        );
</script>

<style>
    /* Acotado a la sombra: `transition: all` chocaba con los transform de GSAP */
    #recepcion-card {
        transition: box-shadow 0.3s ease;
    }

    #recepcion-card:hover {
        box-shadow: 0 20px 40px rgba(94, 21, 36, 0.18);
    }

    /* Animación del botón */
    #recepcion-boton a:active {
        transform: scale(0.95);
    }
</style>
