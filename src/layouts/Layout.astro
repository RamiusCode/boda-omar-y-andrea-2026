---
// src/layouts/Layout.astro
import "../styles/global.css";
export interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="es" class="m-0 p-0">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light only" />
    <link rel="icon" type="image/png" href="/iconos/Anillos.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <!--
      Google Fonts en UNA sola petición.
      Antes eran 4 <link> que pedían Great Vibes y Crimson Text repetidos;
      cada uno bloqueaba el pintado hasta resolverse.
    -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Great+Vibes&family=Crimson+Text:wght@400;600;700&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400&family=Charm:wght@400;700&display=swap"
      rel="stylesheet"
    />

    <!-- Primera foto visible: se pide cuanto antes para que no salte el layout -->
    <link
      rel="preload"
      as="image"
      href="/imagenes/imagen1.webp"
      fetchpriority="high"
    />

    <style>
      /* FORZAR MODO CLARO - DESHABILITAR MODO OSCURO */
      :root {
        color-scheme: light only;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        color-scheme: light only;
      }

      html {
        width: 100%;
        height: 100%;
        overflow-x: hidden;
        color-scheme: light only;
      }

      body {
        margin: 0;
        padding: 0;
        width: 100%;
        min-height: 100vh;
        overflow-x: hidden;
        color-scheme: light only;
        position: relative;
        background-color: #ffffff;
      }

      /*
        Textura de papel.
        Antes era una capa `absolute` tan alta como TODA la página (varios
        miles de píxeles) con una imagen repetida al 50% de opacidad: el
        navegador la tenía que repintar en cada cuadro del scroll.
        Ahora es una capa fija del tamaño de la pantalla, promovida a su
        propia capa de GPU: se pinta una vez y ya no vuelve a costar nada.
      */
      body::before {
        content: "";
        position: fixed;
        inset: 0;
        background-image: url("/imagenes/BlancoTextura.webp");
        background-repeat: repeat;
        background-size: 100% auto;
        opacity: 0.5;
        z-index: 0;
        pointer-events: none;
        transform: translateZ(0);
      }

      main {
        position: relative;
        z-index: 1;
        background: transparent !important;
      }

      /* Prevenir cualquier cambio de color por modo oscuro */
      @media (prefers-color-scheme: dark) {
        :root {
          color-scheme: light only !important;
        }

        html,
        body {
          background-color: white !important;
          color: inherit !important;
        }

        * {
          color-scheme: light only !important;
        }
      }
    </style>
  </head>
  <body class="min-h-screen m-0 p-0">
    <main class="m-0 p-0 overflow-x-hidden">
      <slot />
    </main>
  </body>
</html>
